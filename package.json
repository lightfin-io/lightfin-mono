{
  "name": "@lightfin/monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @lightfin/core dev",
    "www": "bun run --filter @lightfin/www dev",
    "build": "bun run --filter @lightfin/core build && bun run --filter @lightfin/react build",
    "build:www": "bun run --filter @lightfin/core build && bun run --filter @lightfin/react build && bun run --filter @lightfin/www build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "test:e2e": "bun run --filter @lightfin/core test:e2e",
    "size": "bun run --filter '*' size",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^26.6.6",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.10",
    "size-limit": "^14.3.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^3.0.0"
  }
}
