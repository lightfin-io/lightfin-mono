{
  "name": "lightfin-web-chart",
  "version": "0.0.0",
  "description": "A powerful, lightweight, dependency-free financial charting library for the web.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./indicators": {
      "types": "./dist/indicators/index.d.ts",
      "import": "./dist/indicators.js"
    },
    "./indicators/*": {
      "types": "./dist/indicators/*.d.ts",
      "import": "./dist/indicators/*.js"
    },
    "./chrome": {
      "types": "./dist/chrome/index.d.ts",
      "import": "./dist/chrome.js"
    },
    "./annotations": {
      "types": "./dist/annotations/index.d.ts",
      "import": "./dist/annotations.js"
    },
    "./price-lines": {
      "types": "./dist/priceLines/index.d.ts",
      "import": "./dist/price-lines.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "build": "rm -rf dist && vite build && tsc -p tsconfig.build.json",
    "build:demo": "vite build --config vite.demo.config.ts",
    "preview": "vite preview --config vite.demo.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "size-limit",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^14.3.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^26.6.6",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.10",
    "size-limit": "^14.3.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^3.0.0"
  }
}
