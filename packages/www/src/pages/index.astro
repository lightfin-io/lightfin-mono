---
import { Code, Icon } from '@astrojs/starlight/components'
import logo from '../assets/logo.svg'
import FeatureIcon from '../components/FeatureIcon.astro'
import LiveChart from '../components/LiveChart.tsx'
import SignalWave from '../components/SignalWave.astro'
import {
  bundles,
  competitorMultiple,
  reactSize,
} from '../data/bundle-sizes'
import '../styles/landing.css'

const features = [
  {
    icon: 'candles',
    title: 'Professional-grade charting',
    body: 'Switch between 13 styles, including candles, Heikin Ashi, lines and areas. Pan, zoom and inspect prices with the crosshair, volume overlay and current-price line.',
  },
  {
    icon: 'indicators',
    title: 'Indicators built in, or build your own',
    body: 'SMA, EMA, Bollinger, Ichimoku, Parabolic SAR, RSI, MACD, ATR and more ship out of the box, each on its own resizable pane, plus a tree-shakeable indicator framework for authoring custom ones.',
  },
  {
    icon: 'drawing',
    title: '25 drawing tools',
    body: 'Trend lines, channels, Fibonacci, Gann Fan, Elliott waves, Head and Shoulders, shapes, and measurements, with undo/redo and per-drawing styles.',
  },
  {
    icon: 'live',
    title: 'Live data, any source',
    body: 'Bars in, chart out. Attach a DataSource for history backfill and a live stream; follow-mode keeps the latest candle in view.',
  },
  {
    icon: 'react',
    title: 'React bindings',
    body: 'A thin <LightfinChart> wrapper plus a useChartEffect hook wire features imperatively onto the chart while the core stays framework-free.',
  },
  {
    icon: 'package',
    title: 'Zero dependencies',
    body: 'Not one transitive package — no supply-chain surface to audit, no CVEs to chase. The whole library is yours to review, which risk and compliance teams tend to ask about.',
  },
] as const

const perfStats = [
  { value: '500k', unit: 'candles', note: 'panned & zoomed in real time' },
  { value: '60', unit: 'fps', note: 'gesture-driven pan, zoom & crosshair' },
]

const perf = [
  {
    title: 'Batched draw calls',
    body: 'Each series and indicator collapses to a handful of Path2D fills and strokes per frame — up/down candles bucketed by color, a whole line plot in one stroke.',
  },
  {
    title: 'Columnar data, minimal GC',
    body: 'Bars live in parallel typed-array columns — a gap-buffered store, not an array of objects — so appends, backfill and redraws barely touch the garbage collector.',
  },
  {
    title: 'One frame, one paint',
    body: 'A single requestAnimationFrame-batched scheduler coalesces every invalidation into one render pass, drawn on layered canvases at device-pixel sharpness.',
  },
  {
    title: 'Smooth at any scale',
    body: 'O(1) viewport slicing keeps pan, zoom and live follow-mode fluid whether you are showing 500 candles or 500,000.',
  },
]

const install = `npm i @lightfin/core`
const snippet = `import { createChart } from '@lightfin/core'

const chart = createChart(document.querySelector('#chart'), {
  volumeVisible: true,
})
chart.addCandlestickSeries().setData(bars)`
---

<html lang="en" data-theme="dark">
  <head>
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtm.js?id=GTM-TRGH2GGD"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Lightfin — a small, fast web charting library</title>
    <meta
      name="description"
      content="A dependency-free web charting library with professional-grade candlesticks, indicators and drawing tools. Vanilla-TS core, Canvas2D, React bindings."
    />
  </head>
  <body>
    <header class="nav">
      <a class="nav__brand" href="/">
        <img class="nav__mark" src={logo.src} alt="" aria-hidden="true" />
        Lightfin
      </a>
      <nav class="nav__links">
        <a href="/docs/getting-started">Docs</a>
        <a href="/docs/api/chart">Reference</a>
        <a
          class="nav__github"
          href="https://github.com/lightfin-io/lightfin-mono"
          target="_blank"
          rel="noopener"
          aria-label="GitHub (opens in a new tab)"
        >
          GitHub
          <Icon name="github" size="1rem" />
        </a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <div class="hero__copy">
          <h1>Financial charts,<br /><em>without the weight.</em></h1>
          <p class="hero__lede">
            A dependency-free charting library with professional-grade
            candlesticks, indicators, drawing tools and live data — while
            staying small and easy to wire to any source.
          </p>
          <div class="hero__cta">
            <a class="btn btn--primary" href="/docs/getting-started">Get started</a>
            <a class="btn" href="https://github.com/lightfin-io/lightfin-mono">
              <Icon name="github" size="1.1rem" /> View on GitHub
            </a>
          </div>
          <code class="hero__install">{install}</code>
        </div>
        <div class="hero__art"><SignalWave /></div>
      </section>

      <figure class="hero__demo">
        <div class="demo__canvas"><LiveChart client:only="react" height={520} /></div>
        <figcaption class="hero__caption">
          A real <code>@lightfin/core</code> chart with its full chrome,
          streaming live BTC/USDT from Binance.
        </figcaption>
      </figure>

      <section class="features">
        {
          features.map(f => (
            <article class="feature">
              <div class="feature__icon"><FeatureIcon name={f.icon} /></div>
              <h2>{f.title}</h2>
              <p>{f.body}</p>
            </article>
          ))
        }
      </section>

      <section class="bundle" id="bundle">
        <div class="bundle__head">
          <h2>Small and dependency-free</h2>
          <p>
            Our chart lazily loads optional features like toolbars, annotations
            and indicators, so you only pay for what you use.
          </p>
        </div>
        <div class="bundle__bars">
          {
            bundles.map(b => (
              <div class="bar" data-tone={b.tone}>
                <div class="bar__label">
                  <span class="bar__name">{b.label}</span>
                  <span class="bar__size">{b.size}</span>
                </div>
                <div class="bar__track">
                  <span class="bar__fill" style={`--w:${b.width}%`} />
                </div>
              </div>
            ))
          }
        </div>
        <p class="bundle__note">
          Lightfin sizes are brotli-compressed and enforced in CI. The React
          wrapper adds {reactSize} with React and the core left external. The
          comparison bar is capped — a 2&nbsp;MB bundle is roughly {competitorMultiple}&times;
          the full Lightfin build.
        </p>
      </section>

      <section class="perf" id="perf">
        <div class="perf__head">
          <h2>Built to stay at 60fps</h2>
          <p>
            Optimized draw calls, carefully structured columnar data to minimise
            GC, and buttery gestures — right up to half a million candles.
          </p>
        </div>
        <div class="perf__stats">
          {
            perfStats.map(s => (
              <div class="stat">
                <div class="stat__value">
                  {s.value}
                  <span class="stat__unit">{s.unit}</span>
                </div>
                <div class="stat__note">{s.note}</div>
              </div>
            ))
          }
        </div>
        <div class="perf__grid">
          {
            perf.map(p => (
              <article class="perf__card">
                <h3>{p.title}</h3>
                <p>{p.body}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="quickstart">
        <div class="code__copy">
          <h2>Bars in, chart out.</h2>
          <p>
            The core knows nothing about your data or framework. Create a chart,
            add a series, hand it bars. Reach for <code>@lightfin/react</code>,
            indicators, drawing tools or a live <code>DataSource</code> only when
            you need them.
          </p>
          <a class="btn btn--primary" href="/docs/getting-started">Read the docs</a>
        </div>
        <div class="code__block"><Code code={snippet} lang="ts" wrap /></div>
      </section>
    </main>

    <footer class="footer">
      <span>Lightfin — MIT licensed.</span>
      <nav>
        <a href="/docs/getting-started">Docs</a>
        <a href="https://github.com/lightfin-io/lightfin-mono">GitHub</a>
      </nav>
    </footer>

    <script>
      const bundle = document.querySelector('.bundle__bars')
      if (bundle && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const observer = new IntersectionObserver(([entry]) => {
          if (entry?.isIntersecting) {
            entry.target.classList.add('is-visible')
            observer.disconnect()
          }
        })
        observer.observe(bundle)
      }
    </script>
  </body>
</html>
