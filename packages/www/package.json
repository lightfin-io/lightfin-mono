{
  "name": "@lightfin/www",
  "version": "1.0.0",
  "description": "Marketing site and documentation for Lightfin, built with Astro + Starlight.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "gen": "bun run scripts/gen-reference.ts",
    "dev": "bun run gen && astro dev",
    "build": "bun run gen && astro build",
    "preview": "astro preview",
    "preview:cf": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "bun run gen && astro check"
  },
  "dependencies": {
    "@astrojs/react": "^4.2.3",
    "@astrojs/starlight": "^0.34.0",
    "@lightfin/core": "workspace:*",
    "@lightfin/react": "workspace:*",
    "astro": "^5.6.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "~6.0.3",
    "wrangler": "^4.165.0"
  }
}
