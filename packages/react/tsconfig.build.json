{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "rootDir": "src",
    /* Resolve the core from its built declarations (node_modules → the `core`
       workspace's dist), not its source. That keeps core's .ts files out of
       this emit program — they are declarations here, so `rootDir` stays
       satisfied — and it is why `build` builds core before react. */
    "paths": {}
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.tsx", "src/**/*.test.ts"]
}
