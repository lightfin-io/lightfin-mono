{
  "name": "lightfin-web-chart-react",
  "version": "0.0.0",
  "description": "React bindings for lightfin-web-chart: <LightfinChart> plus hooks.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "size": "size-limit"
  },
  "peerDependencies": {
    "lightfin-web-chart": "*",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "lightfin-web-chart": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
