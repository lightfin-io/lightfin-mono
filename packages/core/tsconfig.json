{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Lets the demo import the library by its package name. Runtime resolution
       of this alias is handled by Vite (see vite.demo.config.ts). */
    "paths": {
      "@lightfin/core": ["./src/index.ts"],
      "@lightfin/core/indicators": ["./src/indicators/index.ts"],
      "@lightfin/core/indicators/*": ["./src/indicators/*.ts"],
      "@lightfin/core/chrome": ["./src/chrome/index.ts"],
      "@lightfin/core/annotations": ["./src/annotations/index.ts"],
      "@lightfin/core/annotations/schema": ["./src/annotations/schema.ts"],
      "@lightfin/core/price-lines": ["./src/priceLines/index.ts"]
    },

    /* Strictness */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "src",
    "demo",
    "e2e",
    "vite.config.ts",
    "vite.demo.config.ts",
    "playwright.config.ts"
  ]
}
