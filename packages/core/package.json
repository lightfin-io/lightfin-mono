{
  "name": "@lightfin/core",
  "version": "0.0.2",
  "description": "A powerful, lightweight, dependency-free financial charting library for the web.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://lightfin.io",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./indicators": {
      "types": "./dist/indicators/index.d.ts",
      "import": "./dist/indicators.js"
    },
    "./indicators/*": {
      "types": "./dist/indicators/*.d.ts",
      "import": "./dist/indicators/*.js"
    },
    "./chrome": {
      "types": "./dist/chrome/index.d.ts",
      "import": "./dist/chrome.js"
    },
    "./annotations": {
      "types": "./dist/annotations/index.d.ts",
      "import": "./dist/annotations.js"
    },
    "./annotations/schema": {
      "types": "./dist/annotations/schema.d.ts",
      "import": "./dist/annotations/schema.js"
    },
    "./price-lines": {
      "types": "./dist/priceLines/index.d.ts",
      "import": "./dist/price-lines.js"
    },
    "./event-tags": {
      "types": "./dist/eventTags/index.d.ts",
      "import": "./dist/event-tags.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "build": "rm -rf dist && vite build && tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run build",
    "build:demo": "vite build --config vite.demo.config.ts",
    "preview": "vite preview --config vite.demo.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "size": "size-limit"
  }
}
