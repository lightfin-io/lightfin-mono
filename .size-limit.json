[
  {
    "name": "core (createChart)",
    "path": "dist/index.js",
    "import": "{ createChart }",
    "limit": "15 kB"
  },
  {
    "name": "chrome",
    "path": "dist/chrome.js",
    "import": "{ createChrome }",
    "limit": "11.5 kB"
  },
  {
    "name": "annotations",
    "path": "dist/annotations.js",
    "import": "{ createAnnotations }",
    "limit": "4.5 kB"
  },
  {
    "name": "price lines",
    "path": "dist/price-lines.js",
    "import": "{ addPriceLine }",
    "limit": "1 kB"
  },
  {
    "name": "one indicator (SMA)",
    "path": "dist/indicators/sma.js",
    "limit": "1 kB"
  },
  {
    "name": "all built-in indicators",
    "path": "dist/indicators/*.js",
    "limit": "3.5 kB"
  },
  {
    "name": "everything (core + chrome + annotations + price lines + indicators)",
    "path": [
      "dist/index.js",
      "dist/chrome.js",
      "dist/annotations.js",
      "dist/price-lines.js",
      "dist/indicators/*.js"
    ],
    "limit": "32 kB"
  }
]
